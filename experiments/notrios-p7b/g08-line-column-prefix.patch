+func lineColumnAt(body string, offset int, starts []int) (line int, column int) {
+	// Candidate offsets come from regexp byte locations. utf8.RuneCountInString
+	// has the same invalid-UTF-8 behavior as the previous range loop: every
+	// malformed byte occupies one displayed column.
+	lineIndex := sort.Search(len(starts), func(i int) bool { return starts[i] > offset }) - 1
+	if lineIndex < 0 {
+		lineIndex = 0
+	}
+	return lineIndex + 1, utf8.RuneCountInString(body[starts[lineIndex]:offset]) + 1
 }
 
