+func TestExtractLineColumnsRemainRuneBasedWithManyLinks(t *testing.T) {
+	body := "α [one](one)\nβ [two](two) [three](three)\n[[four]]"
+	links := Extract(body)
+	got := [][2]int{}
+	for _, link := range links {
+		got = append(got, [2]int{link.Line, link.Column})
+	}
+	want := [][2]int{{1, 3}, {2, 3}, {2, 14}, {3, 1}}
+	if len(got) != len(want) {
+		t.Fatalf("got %d links, want %d: %#v", len(got), len(want), links)
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("link %d line/column = %v, want %v", i, got[i], want[i])
+		}
+	}
+}
+
+func TestExtractLineColumnsKeepInvalidUTF8ByteColumns(t *testing.T) {
+	// Go range treats this malformed byte as RuneError of width one. The
+	// optimized prefix count must retain that stored source-coordinate rule.
+	body := "x\xff [target](doc)"
+	links := Extract(body)
+	if len(links) != 1 {
+		t.Fatalf("got %#v", links)
+	}
+	if links[0].Line != 1 || links[0].Column != 4 {
+		t.Fatalf("line/column = %d/%d, want 1/4", links[0].Line, links[0].Column)
+	}
+}
